# Apartados — copia a .env.local / .env y completa. No subas secretos al repo.
# Pey — portal.mipey.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
# Secreto de webhook de Pey (Standard Webhooks, prefijo whsec_).
# Se crea en portal.pey.mx > Desarrollador > API Keys > Apartados >
# Configuración, poniendo la URL del webhook; el secreto se muestra
# una sola vez al crearlo. Sin él, el webhook no se confirma.
PEY_API_BASE_URL=https://api.pey.mx
API_PORT=3001
# Orígenes permitidos por CORS, separados por coma. En prod, la URL de la web.
CORS_ORIGINS=http://localhost:3000
# Google Calendar — Google Cloud, Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/google/callback
# Auth Fase 1 — "Entrar con Google" (solo Google, nada de magic link).
# El callback de login es una redirect URI DISTINTA a la de calendario:
# hay que añadirla al cliente OAuth "Apartados Web" en GCP (APIs y
# servicios > Credenciales > Apartados Web > URIs de redirección
# autorizados). En prod, añadir también la URL de producción.
AUTH_GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# A dónde vuelve la web tras el login (Vercel en prod).
WEB_URL=http://localhost:3000
# Secreto para firmar el state anti-CSRF de OAuth (32+ bytes aleatorios,
# distinto por entorno). Generar con: openssl rand -hex 32
OAUTH_STATE_SECRET=
# Cifrado del refresh_token de calendario en reposo (AES-256-GCM, 32 bytes
# en base64). Generar con: openssl rand -base64 32
# Sin esta variable, conectar el calendario falla a propósito (fail-closed):
# el refresh_token nunca se guarda en claro.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Auth Fase 3 — dueño real de barberia-demo (por googleSub, nunca por email).
# La barbería demo se reclama en el login del googleSub que pongas aquí
# (ver apps/api/src/services/demo-owner.ts): el seed no puede asignar
# dueño porque el id interno del usuario solo existe tras su primer login,
# y el store en memoria se resetea en cada reinicio. Para obtener tu
# googleSub: entra con Google y abre GET /auth/me (la respuesta lo trae).
# Sin esta variable la demo sigue sin dueño y su PATCH da 403 para todos.
# En prod va en Render, NO en el repo.
DEMO_OWNER_GOOGLE_SUB=
# Calendario de pruebas (id) y token de acceso de pruebas, si ya tienes uno.
GOOGLE_TEST_CALENDAR_ID=
GOOGLE_TEST_ACCESS_TOKEN=
# Base de datos — Supabase / Postgres local.
# En Supabase: dashboard del proyecto > Connect > Direct > Session pooler
# (puerto 5432), copia el string y reemplaza [YOUR-DATABASE-PASSWORD].
# Sin DATABASE_URL la API arranca con el store en memoria (dev local);
# con ella, usa Prisma + Postgres y los datos sobreviven a reinicios.
# Si la API no conecta con la URL tal cual, añade ?sslmode=require al final.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apartados
# Demo por defecto (cámbiala con una palabra): barbería, $50 MXN
DEMO_NICHE=barberia
DEMO_DEPOSIT_MXN=50
HOLD_MINUTES=10
# Render (producción, plan gratis) — ver docs/deploy-render.md.
# Estas variables se ponen en el dashboard de Render, NO en este archivo:
# PEY_API_KEY, PEY_WEBHOOK_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# GOOGLE_REDIRECT_URI, CORS_ORIGINS.
# Valores en prod (cuando la API ya tenga su URL https://<tu-api>.onrender.com):
#   CORS_ORIGINS=https://apartados-one.vercel.app
#   GOOGLE_REDIRECT_URI=https://<tu-api>.onrender.com/google/callback
# PORT la inyecta Render (la API lee PORT ?? API_PORT ?? 3001); no se define.
# WEB_URL, AUTH_GOOGLE_REDIRECT_URI, OAUTH_STATE_SECRET y
# GOOGLE_TOKEN_ENCRYPTION_KEY son del login con Google y del calendario
# (auth Fases 1 y 2) y también van en Render.
